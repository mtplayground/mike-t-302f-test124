# Backend runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# Dev CORS. Use true to reflect any request origin, false to disable, or a comma-separated allowlist.
CORS_ORIGIN=true

# SQLite database file used by the backend persistence layer.
SQLITE_PATH=./data/app.sqlite

# Built frontend directory served by the backend in production.
FRONTEND_STATIC_DIR=../frontend/dist
